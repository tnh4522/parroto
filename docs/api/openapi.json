  "info": {
    "title": "LinguaCraft Independent API",
    "description": "Modular NestJS API for Dictation, Shadowing, Vocabulary/SM-2, IELTS & TOEIC Exams, Community Speaking, and Billing.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MagicLinkSwaggerDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "learner@linguacraft.app"
          }
        },
        "required": [
          "email"
        ]
      },
      "OAuthExchangeSwaggerDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "codeVerifier": {
            "type": "string"
          },
          "redirectUri": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "codeVerifier",
          "redirectUri"
        ]
      },
      "OnboardingSwaggerDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "alex_english"
          },
          "birthDate": {
            "type": "string",
            "example": "1998-05-12"
          },
          "preferredTranslateLang": {
            "type": "string",
            "example": "vi"
          }
        }
      },
      "UserPreferencesSwaggerDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Alex Rivera"
          },
          "preferredUiLocale": {
            "type": "string",
            "enum": [
              "en",
              "vi"
            ]
          },
          "preferredTranslateLang": {
            "type": "string",
            "example": "vi"
          },
          "birthDate": {
            "type": "string",
            "example": "1998-05-12"
          }
        }
      },
      "PresignUploadSwaggerDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "SHADOWING_RECORDING",
              "SPEAKING_CLIP"
            ]
          },
          "mimeType": {
            "type": "string",
            "example": "audio/webm;codecs=opus"
          },
          "contentLength": {
            "type": "number",
            "example": 48200
          }
        },
        "required": [
          "purpose",
          "mimeType",
          "contentLength"
        ]
      },
      "TranscribeFallbackSwaggerDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "default": "en"
          }
        },
        "required": [
          "assetId",
          "language"
        ]
      },
      "SubmitSpeechAssessmentSwaggerDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "SHADOWING",
              "IELTS_SPEAKING",
              "TOEIC_SPEAKING"
            ]
          },
          "language": {
            "type": "string",
            "default": "en"
          },
          "referenceText": {
            "type": "string"
          },
          "ieltsPart": {
            "type": "number",
            "enum": [
              1,
              2,
              3
            ]
          },
          "promptQuestion": {
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "mode"
        ]
      },
      "VocabExplainSwaggerDto": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "example": "resilient"
          },
          "cefrLevel": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "contextSentence": {
            "type": "string"
          }
        },
        "required": [
          "word"
        ]
      },
      "ToeicExplainSwaggerDto": {
        "type": "object",
        "properties": {
          "transcript": {
            "type": "string"
          },
          "questionPrompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correctAnswer": {
            "type": "string"
          }
        },
        "required": [
          "transcript",
          "questionPrompt",
          "options",
          "correctAnswer"
        ]
      },
      "SentenceAttemptSwaggerDto": {
        "type": "object",
        "properties": {
          "sentenceId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "DICTATION",
              "SHADOWING"
            ]
          },
          "accuracyScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "mistakesCount": {
            "type": "number",
            "default": 0
          },
          "replayCount": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "sentenceId",
          "mode",
          "accuracyScore"
        ]
      },
      "ImportYoutubeSwaggerDto": {
        "type": "object",
        "properties": {
          "youtubeUrl": {
            "type": "string",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          },
          "topicIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "youtubeUrl"
        ]
      },
      "CreateVocabDeckSwaggerDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Academic Essay Verbs"
          },
          "description": {
            "type": "string"
          },
          "cefrLevel": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ],
            "default": "PRIVATE"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "exampleSentence": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "title",
          "cefrLevel",
          "visibility",
          "cards"
        ]
      },
      "SrsReviewSwaggerDto": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "format": "uuid"
          },
          "rating": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1=Again, 2=Hard, 3=Good, 4=Easy"
          }
        },
        "required": [
          "cardId",
          "rating"
        ]
      },
      "StartExamSessionSwaggerDto": {
        "type": "object",
        "properties": {
          "examId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "TEST",
              "PRACTICE"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "examId",
          "mode"
        ]
      },
      "SaveExamAnswersSwaggerDto": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionNumber": {
                  "type": "number"
                },
                "selectedValue": {
                  "type": "string"
                },
                "isFlagged": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "required": [
          "answers"
        ]
      },
      "CreateCommentSwaggerDto": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string",
            "enum": [
              "LESSON",
              "STORY",
              "EXAM"
            ]
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "targetType",
          "targetId",
          "content"
        ]
      },
      "CreateSpeakingRoomSwaggerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Evening IELTS Speaking Practice"
          },
          "topic": {
            "type": "string",
            "example": "IELTS Speaking"
          },
          "cefrLevel": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "maxParticipants": {
            "type": "number",
            "minimum": 2,
            "maximum": 5,
            "default": 4
          },
          "isPrivate": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name",
          "topic",
          "cefrLevel",
          "maxParticipants",
          "isPrivate"
        ]
      },
      "CheckoutSwaggerDto": {
        "type": "object",
        "properties": {
          "planCode": {
            "type": "string",
            "example": "PRO_1M"
          },
          "provider": {
            "type": "string",
            "enum": [
              "stripe",
              "paddle",
              "vietqr"
            ]
          },
          "promoCode": {
            "type": "string"
          },
          "affiliateCode": {
            "type": "string"
          }
        },
        "required": [
          "planCode",
          "provider"
        ]
      },
      "WebhookSwaggerDto": {
        "type": "object",
        "properties": {
          "providerTxId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PAID",
              "FAILED",
              "REFUNDED"
            ]
          }
        },
        "required": [
          "providerTxId",
          "status"
        ]
      },
      "ShopPurchaseSwaggerDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "itemId"
        ]
      }
    }
  }
}