NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://linguacraft:linguacraft_dev_password@localhost:5432/linguacraft?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-this-access-secret-minimum-32-chars-dev
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-chars-dev
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linguacraft-media
S3_ACCESS_KEY_ID=linguacraft_minio
S3_SECRET_ACCESS_KEY=linguacraft_minio_password
S3_FORCE_PATH_STYLE=true

AI_PROVIDER=mock
BILLING_WEBHOOK_SECRET_STRIPE=whsec_dev_secret
BILLING_WEBHOOK_SECRET_PADDLE=pdl_dev_secret
BILLING_WEBHOOK_SECRET_VIETQR=vqr_dev_secret
